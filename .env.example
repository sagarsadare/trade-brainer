# --- Zerodha Kite Connect app credentials -------------------------------
# Create an app at https://developers.kite.trade/apps  (Rs.500/mo)
# Historical intraday OI requires the "Historical Data" add-on (Rs.2000/mo).
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Set this EXACT value as the app's "Redirect URL" in the Kite developer
# console so the login handshake completes automatically.
KITE_REDIRECT_URL=http://127.0.0.1:8000/auth/kite/callback

# --- Collection tuning ---------------------------------------------------
# Number of strikes on EACH side of ATM (10 => 21 strikes => 42 options/expiry)
STRIKE_WINDOW=10

# Continuous-session close in IST. NSE circular FAOP74467 introduces the
# Closing Auction Session (15:30-15:40) from 2026-08-03; continuous trading
# still ends 15:30, so slots stop there. Set to 15:40 to also capture CAS.
SESSION_CLOSE=15:30

# --- Paths ---------------------------------------------------------------
TRADEBRAIN_DB=data/pcr.db

# --- Calendar spread: live order placement -------------------------------
# Paper mode always works. Real orders are refused outright unless this is
# true, AND the UI still requires an exact typed confirmation per basket.
ALLOW_LIVE_ORDERS=false
